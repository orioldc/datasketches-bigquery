config { hasOutput: true, tags: ["theta", "udfs"] }

CREATE OR REPLACE FUNCTION ${self()}(sketchA BYTES, sketchB BYTES, seed INT64)
RETURNS FLOAT64
OPTIONS (
  description = '''Computes the estimated cardinality of A-not-B (set difference) of two given sketches.

Param sketchA: the first sketch "A" as BYTES.
Param sketchB: the second sketch "B" as BYTES.
Param seed: This is used to confirm that the given sketches were configured with the correct seed.
Returns: Estimated cardinality of A-not-B as FLOAT64.

Uses set arithmetic: |A - B| = |A| - |A ∩ B|

For more information:
 - https://datasketches.apache.org/docs/Theta/ThetaSketches.html
'''
) AS (
  GREATEST(0, 
    ${ref("theta_sketch_get_estimate_seed")}(sketchA, seed) - 
    ${ref("theta_sketch_intersection_two")}(sketchA, sketchB, seed)
  )
);